## Edgeplane — dev environment defaults
## Copy to .env.dev: cp .env.dev.example .env.dev
## All values here are safe for local dev. Do not use in production.

# ── API ──────────────────────────────────────────────────────────────────────
EP_BASE_URL=http://localhost:8008
EP_OUTPUT=human
OIDC_REQUIRED=false
OIDC_ISSUER_URL=https://auth.example.com/application/o/edgeplane/
OIDC_AUDIENCE=dev
OIDC_JWKS_URL=https://auth.example.com/application/o/edgeplane/jwks/
OIDC_CLIENT_ID=dev
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8008/auth/oidc/callback
OIDC_SCOPES=openid profile email

# Comma-separated emails granted admin access without OIDC
EP_ADMIN_EMAILS=
# Service token subject gets admin rights in dev so scripts/tests can self-clean
EP_ADMIN_SUBJECTS=token-client

EP_REQUEST_TIMEOUT_SECONDS=30
EP_CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:8008

# ── Database ─────────────────────────────────────────────────────────────────
# DATABASE_URL is derived from POSTGRES_* vars in docker-compose.edgeplane-dev.yml.
# For direct runs outside Docker: DATABASE_URL=postgres://edgeplane:edgeplane@localhost:5432/edgeplane

# ── Object storage (rustfs dev instance) ─────────────────────────────────────
EP_OBJECT_STORAGE_ENDPOINT=http://localhost:9000
EP_OBJECT_STORAGE_REGION=us-east-1
EP_OBJECT_STORAGE_BUCKET=edgeplane
EP_OBJECT_STORAGE_SECURE=false
EP_OBJECT_STORAGE_ACCESS_KEY=edgeplane
EP_OBJECT_STORAGE_ACCESS_SECRET=edgeplane-secret

# ── AI runtimes ──────────────────────────────────────────────────────────────
EP_CLAUDE_MODEL=claude-sonnet-4-5
EP_CLAUDE_MAX_TOKENS=4096
EP_CLAUDE_TIMEOUT_SECONDS=120

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_API_BASE=

# ── Governance (permissive defaults for dev) ──────────────────────────────────
EP_GOV_PROFILE=
EP_GOV_REQUIRE_APPROVAL_FOR_MUTATIONS=false
EP_GOV_ALLOW_CREATE_WITHOUT_APPROVAL=true
EP_GOV_ALLOW_UPDATE=true
EP_GOV_ALLOW_DELETE=true
EP_GOV_ALLOW_PUBLISH=true
EP_GOV_MCP_ALLOW_MUTATION_TOOLS=true

# ── Rate limits (relaxed for dev) ─────────────────────────────────────────────
EP_RATE_LIMIT_DEFAULT_CAPACITY=9999
EP_RATE_LIMIT_DEFAULT_WINDOW_SECONDS=60
EP_RATE_LIMIT_SEARCH_CAPACITY=9999
EP_RATE_LIMIT_SEARCH_WINDOW_SECONDS=60
EP_RATE_LIMIT_WRITE_CAPACITY=9999
EP_RATE_LIMIT_WRITE_WINDOW_SECONDS=60

# ── Notifications (optional) ──────────────────────────────────────────────────
EP_NOTIFICATION_WEBHOOK_URL=
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
GOOGLE_CHAT_VERIFICATION_TOKEN=
TEAMS_VERIFICATION_TOKEN=
