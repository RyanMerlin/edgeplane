[Unit]
Description=edgeplaned — Edgeplane daemon
Documentation=https://github.com/edgeplane/edgeplane
After=network.target
Wants=network.target

[Service]
Type=simple
ExecStart=%h/.cargo/bin/edgeplaned run
# PATH for spawned subprocesses (e.g. `goose` for dispatch=goose cron jobs).
# systemd user services get a minimal PATH by default — set it explicitly so
# tools installed under the user's cargo/local bin are reachable.
Environment=PATH=%h/.cargo/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=5s

# Pass secrets via environment or a credentials file — never hardcode tokens.
# EnvironmentFile=%h/.ep/edgeplaned/edgeplaned.env
# EP_BACKEND_URL and MCD_WORK_DIR can also be set in ~/.ep/edgeplaned/config.yaml

WorkingDirectory=%h/.ep/edgeplaned

TimeoutStopSec=30
KillMode=mixed
KillSignal=SIGTERM

StandardOutput=journal
StandardError=journal
SyslogIdentifier=edgeplaned

LimitNOFILE=65536

[Install]
WantedBy=default.target
