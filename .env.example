## Edgeplane API (local/dev)
EP_BASE_URL=http://localhost:8008
EP_OUTPUT=human
# Optional override. Leave unset to derive from saved login (email/subject).
EP_AGENT_ID=
AUTH_MODE=oidc
OIDC_REQUIRED=false
OIDC_ISSUER_URL=https://auth.example.com/application/o/edgeplane/
OIDC_AUDIENCE=<AUTH_KEY>
OIDC_JWKS_URL=https://auth.example.com/application/o/edgeplane/jwks/
OIDC_CLIENT_ID=<AUTH_KEY>
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8008/auth/oidc/callback
OIDC_SCOPES=openid profile email
EP_ADMIN_SUBJECTS=
EP_ADMIN_EMAILS=
EP_REQUEST_TIMEOUT_SECONDS=30
EP_RATE_LIMIT_DEFAULT_CAPACITY=240
EP_RATE_LIMIT_DEFAULT_WINDOW_SECONDS=60
EP_RATE_LIMIT_SEARCH_CAPACITY=60
EP_RATE_LIMIT_SEARCH_WINDOW_SECONDS=60
EP_RATE_LIMIT_WRITE_CAPACITY=120
EP_RATE_LIMIT_WRITE_WINDOW_SECONDS=60
EP_RATE_LIMIT_APPROVAL_CAPACITY=30
EP_RATE_LIMIT_APPROVAL_WINDOW_SECONDS=60
EP_SCHEMA_PACK_FILE=
VECTOR_STORE_BACKEND=
EP_CORS_ALLOW_ORIGINS=http://localhost:7007,http://localhost:8008
EP_GOV_PROFILE=
EP_GOV_REQUIRE_APPROVAL_FOR_MUTATIONS=
EP_GOV_ALLOW_CREATE_WITHOUT_APPROVAL=
EP_GOV_ALLOW_UPDATE=
EP_GOV_ALLOW_DELETE=
EP_GOV_ALLOW_PUBLISH=
EP_GOV_MCP_ALLOW_MUTATION_TOOLS=
EP_GOV_TERMINAL_ALLOW_CREATE_ACTIONS=
EP_GOV_TERMINAL_ALLOW_PUBLISH_ACTIONS=
EP_APPROVAL_TOKEN_SECRET=
EP_ALLOW_LEGACY_APPROVAL_CONTEXT=
EP_NOTIFICATION_WEBHOOK_URL=
EP_AI_PROVIDER=
EP_AI_MODEL=
EP_AI_BASE_URL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
EP_CENTRAL_RUNTIME_DEFAULT=claude_code
EP_CLAUDE_MODEL=claude-sonnet-4-5
EP_CLAUDE_MAX_TOKENS=4096
EP_CLAUDE_TIMEOUT_SECONDS=120
EP_OBJECT_STORAGE_ENDPOINT=
EP_OBJECT_STORAGE_REGION=us-east-1
EP_OBJECT_STORAGE_BUCKET=edgeplane
EP_OBJECT_STORAGE_SECURE=true
EP_OBJECT_STORAGE_ACCESS_KEY=
EP_OBJECT_STORAGE_ACCESS_SECRET=
SLACK_SIGNING_SECRET=
SLACK_SIGNATURE_TOLERANCE_SEC=300
SLACK_BOT_TOKEN=
GOOGLE_CHAT_VERIFICATION_TOKEN=
TEAMS_VERIFICATION_TOKEN=

